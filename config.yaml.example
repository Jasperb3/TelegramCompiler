telegram:
  api_id: 123456                    # integer API ID from my.telegram.org/apps
  api_hash: "your_api_hash_here"    # hex string from my.telegram.org/apps — or use TG_API_HASH env var
  session_name: "briefing_session"  # filename for the Telegram session (no extension)
  channels:
    - username: "@channelname"      # public @username, or omit and use id: below
      slug: "news"                  # short label used in file paths and the briefing
      priority: 1.0                 # composite score multiplier (0.1–2.0); higher = channel ranked more prominently
      credibility: 1.0              # channel credibility prior (0.1–2.0), also multiplied into the composite score
      # id: 1234567890              # numeric channel ID — use for private channels instead of username
      # custom_prompt: |            # override the default LLM system prompt for this channel only
      #   You are an analyst specialised in ...
    - username: "@another_channel"
      slug: "intel"
      priority: 0.8
  rate_limit_delay_ms: 500          # pause between channel scrapes in ms (be conservative with Telegram)
  lookback_seconds: 604800          # how far back to fetch on first run / after cursor reset (default: 1 week)

lmstudio:
  model: "google/gemma-4-12b-qat"   # model name as shown in LM Studio (must be loaded)
  server_host: "localhost"           # IP or hostname if LM Studio runs on another machine
  server_port: 1234
  # api_token: "lms-..."            # optional — overridden by LM_API_TOKEN env var
  temperature: 0.3
  # Per-post analysis token budget (replaces the old fixed max_tokens):
  #   budget = min(analysis_base_tokens + text_chars * analysis_tokens_per_char
  #                + images * analysis_tokens_per_image, analysis_max_tokens)
  # so short posts stay cheap and long/image-heavy posts get headroom. The base is
  # deliberately generous because reasoning models burn ~800+ tokens deliberating
  # before emitting JSON, and LM Studio exposes no way to cap reasoning separately.
  analysis_base_tokens: 1500        # flat floor: reasoning deliberation + structured JSON output
  analysis_tokens_per_char: 0.3     # extra budget per character of prompt text (post text is truncated at 3000 chars)
  analysis_tokens_per_image: 250    # extra budget per attached image (max 3 per post)
  analysis_max_tokens: 4000         # hard ceiling on any single analysis call
  synthesis_max_tokens: 24000       # token budget for the intel front-page synthesis (keep generous: reasoning models deliberate before emitting JSON)
  max_concurrent_analyses: 1        # parallel LLM calls per batch run; increase if your hardware allows
  # Batched analysis — several posts per LLM call. Reasoning models spend most of
  # their output budget deliberating, and that cost is largely per *call*, so
  # batching amortises it: measured on prism-ml/bonsai-27b, a batch of 10 spent
  # 693 reasoning tokens per post against 3,515 when sent one at a time (39.6 vs
  # 191 s/post). Images amortise far less (they dominate the prompt), hence the
  # separate, smaller size for media-bearing posts. Both sizes at 1 = one post per
  # call = the original behaviour.
  # Only worth raising above 1 for a *reasoning* analysis model, whose per-call
  # deliberation is what batching amortises. For a non-reasoning model a batch of
  # 10 measured 1.7x faster while producing 36% shorter summaries and 36% fewer
  # entities — see the Throughput section of README.md.
  batch_size: 1                     # text-only posts per LLM call
  batch_size_with_images: 1         # media-bearing posts per LLM call
  batch_images_per_post: 1          # images attached per post inside a batch
  #   budget = min(batch_base_tokens + posts * batch_tokens_per_post
  #                + text_chars * batch_tokens_per_char
  #                + images * batch_tokens_per_image, batch_max_tokens)
  # Sized from measurement: a batch of 10 text posts spent 9,364 completion tokens
  # on prism-ml/bonsai-27b, a batch of 3 image posts 7,668. Too small a budget shows
  # up as finish_reason='length' and a partially salvaged batch in the logs.
  batch_base_tokens: 4000           # flat reasoning allowance shared by the whole call
  batch_tokens_per_post: 600        # JSON output allowance per post in the batch
  batch_tokens_per_char: 0.3        # extra budget per character of batched prompt text
  batch_tokens_per_image: 1200      # extra budget per image attached in a batch
  batch_max_tokens: 32000           # hard ceiling on any batch call
  batch_max_prompt_chars: 24000     # split a batch whose prompt text would exceed this
  batch_min_yield_ratio: 0.6        # if a batch returns less than this fraction, retry its posts one by one
  # Per-stage models. Analysis scores every scraped post and wants a small, fast,
  # non-reasoning VLM; synthesis runs once over the whole triaged day and is where
  # reasoning actually earns its cost. Both fall back to `model` when unset.
  # analysis_model: "mistralai/ministral-3-3b"
  # synthesis_model: "prism-ml/bonsai-27b"
  # With manage_models on, the LM Studio SDK loads each stage's model at the stage
  # boundary and unloads the previous one — necessary when the models cannot
  # co-reside in VRAM (a 27B leaves ~4 GB free on a 16 GB card). It fails loudly
  # if the SDK cannot reach LM Studio.
  manage_models: false              # opt in to SDK-driven load/unload between stages
  unload_others: true               # unload other loaded LLMs before loading a stage's model
  model_ttl_seconds: 3600           # LM Studio unloads an idle model after this, so a crashed run strands nothing
  # model_context_length: 32768     # optional load-time context override

triage:
  keywords: ["urgent", "breaking", "launch"]  # words that add keyword_boost to a post's score
  keyword_boost: 0.5        # score added when a keyword matches (capped at 5.0 total)
  min_composite_score: 3.5  # posts below this threshold go to the Appendix section
  min_main_items: 15        # if fewer posts clear the threshold, top appendix items are promoted to fill
  max_main_items: 50        # hard cap on main briefing length (excess → appendix)
  dedup_window_secs: 7200   # time window for entity-overlap deduplication (default: 2h)
  dedup_summary_window_secs: 21600   # time window for summary/title word-overlap dedup (default: 6h)
  entity_cluster_window_secs: 86400  # wider entity-cluster dedup window (default: 24h)
  dedup_jaccard_threshold: 0.28      # min word-overlap ratio for summary/title dedup
  dedup_entity_overlap_count: 3      # shared entities required within dedup_window_secs
  dedup_entity_cluster_overlap_count: 4  # shared entities required within entity_cluster_window_secs
  recency_half_life_hours: 24.0      # composite score halves every this many hours of post age
  recency_floor: 0.7                 # minimum recency multiplier, however old the post
  threat_multipliers:                # ranking multiplier per threat badge (badge itself is unchanged)
    CRITICAL: 1.15
    HIGH: 1.05
    MODERATE: 1.0
    LOW: 0.85
  corroboration_weight: 0.15         # score multiplier added per corroborating channel (1 + w*n)
  corroboration_cap: 1.5             # max total multiplier from corroboration boost
  rumor_penalty: 0.7                 # score multiplier applied to posts categorised "Rumor"

generation:
  output_dir: "./briefings"         # where PDFs and markdown are saved
  generate_at: "23:59"              # daily auto-generation time in daemon mode (HH:MM, in the timezone below)
  # NOTE: the briefing date is always the UTC calendar date. Pick a generate_at
  # whose UTC equivalent is late in the day being reported, not just after UTC midnight.
  timezone: "UTC"                   # IANA timezone for generate_at scheduling (e.g. "Europe/London", "America/New_York")
  pdf_layout: "desktop"             # PDF CSS layout: "desktop" or "mobile" (override with --layout)
  # share_to_directory: "/path/to/shared/folder"  # if set, copy the final PDF here after generation
  # Intelligence Assessment coverage is controlled by triage.max_main_items (default: 50)

storage:
  db_path: "./data/briefing.db"
  media_dir: "./data/media"
  retention_days: 30                # delete media older than this many days
